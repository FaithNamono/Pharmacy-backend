# Django Settings
DJANGO_SECRET_KEY=your-secret-key-here
DEBUG=False
ALLOWED_HOSTS=.onrender.com,localhost,127.0.0.1

# Database
# Using SQLite (see settings.py) — no DATABASE_URL needed on Render for this setup

# Email Settings (Brevo transactional email API)
# Get BREVO_API_KEY from Brevo → Settings → SMTP & API → API Keys
# BREVO_SENDER_EMAIL must be a sender you've verified in Brevo → Settings → Senders & IP
BREVO_API_KEY=your-brevo-api-key-here
BREVO_SENDER_EMAIL=faithnamono4@gmail.com
BREVO_SENDER_NAME=Dervin Pharmacy

# CORS Settings (add your actual frontend URLs)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000